# Inference Dockerfile for resoterre
# This image is built on top of the base image and configured for running inference with snakemake

FROM resoterre-base:latest

# Install snakemake
RUN pip install snakemake

# Build argument for model path (can be overridden at build time)
ARG MODEL_PATH=model/model.safetensors

# Set working directory
WORKDIR /app

# Copy the trained model and rename it to model.safetensors
COPY --from=model ${MODEL_PATH} /app/model/model.safetensors
RUN chmod -R a+r /app/model

# Copy regridding weight matrices
COPY --from=matrix rdps_to_hrdps_coo_matrix_lon_284.30_lat_45.42_512_4.npz /app/matrix/
COPY --from=matrix rdps_to_hrdps_csr_matrix_lon_284.30_lat_45.42_512_4.npz /app/matrix/
RUN chmod -R a+r /app/matrix

# Copy scripts directory (needed for snakemake workflows)
COPY scripts/ /app/scripts/

# Set environment variables for inference
ENV PYTHONPATH=/app

# The entrypoint runs snakemake with the downscaling workflow
ENTRYPOINT ["snakemake", "-s", "scripts/meta_workflows/downscaling/rdps_to_hrdps.smk", "-j1"]

# Default config and output directory (can be overridden at runtime)
CMD ["--config", "config_yaml=/app/configs/downscaling/downscaling_rdps_to_hrdps.yaml", "--directory=/app/outputs"]
